# ============================================================
# ULPF - Environment Configuration (template)
# Copy to .env and adjust values for your deployment.
# NEVER commit the real .env file (contains secrets).
# ============================================================

# ---- Core application ----
ULPF_ENV=development
ULPF_APP_HOST=0.0.0.0
ULPF_APP_PORT=5000
ULPF_LOG_LEVEL=INFO

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_LOGS=raw-logs
KAFKA_TOPIC_PARSED_LOGS=parsed-logs
KAFKA_TOPIC_NORMALIZED_EVENTS=normalized-events
KAFKA_TOPIC_FAILED_EVENTS=failed-events
KAFKA_TOPIC_SCHEMA_DRIFT=schema-drift-events
KAFKA_GROUP_ID=ulpf-processing
KAFKA_AUTO_OFFSET_RESET=latest

# ---- MinIO (raw vault - S3-compatible) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ChangeMeMinio123!
MINIO_RAW_BUCKET=ulpf-raw-events
MINIO_SECURE=false

# ---- OpenSearch (normalized, searchable events) ----
OPENSEARCH_HOST=localhost:9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_PREFIX=ulpf

# ---- PostgreSQL (users, RBAC, registry, sources, schemas) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ulpf
POSTGRES_USER=ulpf
POSTGRES_PASSWORD=ChangeMePostgres123!
POSTGRES_MIN_POOL=2
POSTGRES_MAX_POOL=10

# ---- Security / JWT ----
JWT_SECRET_KEY=ChangeMeJWTSecretKey-ReplaceInProd-UseALongRandomValue
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
PASSWORD_HASH_SCHEME=scrypt

# ---- Ingestion ----
SYSLOG_UDP_PORT=5514
REST_INGEST_PORT=8000
SYSLOG_TCP_PORT=514

# ---- Hashing / lineage ----
HASH_ALGORITHM=sha256
LINEAGE_HASH_SEED=

# ---- AI parser generator (optional) ----
AI_PARSER_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4o
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
